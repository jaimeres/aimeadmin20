{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DeployClientIdentityCheck",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    },
    {
      "Sid": "DeployClientListSourceBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::erp.jukaime.com"
    },
    {
      "Sid": "DeployClientReadAndMoveSourceObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::erp.jukaime.com/*"
    },
    {
      "Sid": "DeployClientBackupObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::respaldo.erp.jukaime.com/respaldo/*"
    },
    {
      "Sid": "DeployClientBackupBucketLocation",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::respaldo.erp.jukaime.com"
    },
    {
      "Sid": "DeployClientCloudFrontInvalidation",
      "Effect": "Allow",
      "Action": "cloudfront:CreateInvalidation",
      "Resource": "arn:aws:cloudfront::767398139383:distribution/EK8T66IGB5BSN"
    }
  ]
}
